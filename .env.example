# Server
PORT=6000
HOST=0.0.0.0
NODE_ENV=production
# Set to "true" when running behind Nginx/fly/a load balancer so
# X-Forwarded-Proto / X-Forwarded-For are trusted.
TRUST_PROXY=true
# Absolute public URL used in API responses (optional).
# BASE_URL=https://paste.example.com

# Storage
DATA_DIR=./data
# One-time import of old `pastes/*.txt` files on boot.
LEGACY_PASTES_DIR=./pastes

# Paste rules
ID_LENGTH=6
MAX_CONTENT_BYTES=524288
RATE_LIMIT_MAX=30
# "ip" (default when TRUST_PROXY=true) or "ip+ua" (default otherwise)
# RATE_LIMIT_SCOPE=ip
DEFAULT_EXPIRY_DAYS=0
MAX_EXPIRY_DAYS=365
CLEANUP_INTERVAL_MS=600000
