# Server
PORT=6000
HOST=0.0.0.0
NODE_ENV=production
# Set to "true" when running behind Nginx/fly/a load balancer so
# X-Forwarded-Proto / X-Forwarded-For are trusted (also adds HSTS).
TRUST_PROXY=true
# Optional HTTP Basic auth for the whole site ("user:password").
# BASIC_AUTH=
# Absolute public URL used in API responses (optional, recommended in prod).
# BASE_URL=https://paste.example.com

# Storage
DATA_DIR=./data
# Set to "none" to skip the one-time import of old `pastes/*.txt` files.
LEGACY_PASTES_DIR=./pastes

# Paste rules
ID_LENGTH=6
MAX_CONTENT_BYTES=524288
RATE_LIMIT_MAX=30
# "ip" (default when TRUST_PROXY=true) or "ip+ua" (default otherwise)
# RATE_LIMIT_SCOPE=ip
DEFAULT_EXPIRY_DAYS=0
# 0 = no upper bound on client-requested expiry
MAX_EXPIRY_DAYS=365
CLEANUP_INTERVAL_MS=600000
